STOP


7. Python Source Code
import mathdef calculate_metrics(returns, rf=0.02):    n = len(returns)    if n < 2:        return "At least two returns are required."    avg_ret = sum(returns) / n    variance = sum(        (r - avg_ret) ** 2 for r in returns    ) / (n - 1)    std_dev = math.sqrt(variance)    sharpe = (        (avg_ret - rf) / std_dev        if std_dev != 0 else 0    )    return {        "mean": round(avg_ret, 4),        "volatility": round(std_dev, 4),        "sharpe": round(sharpe, 2)    }monthly_returns = [0.03, 0.02, -0.01, 0.04, 0.015]print("Portfolio Metrics:", calculate_metrics(monthly_returns))



