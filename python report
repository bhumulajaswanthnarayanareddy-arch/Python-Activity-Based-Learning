inventory = {    "Laptop": {"price": 1200, "stock": 5},    "Mouse": {"price": 25, "stock": 20}}def generate_bill(cart):    subtotal = 0    for item, qty in cart.items():        if item in inventory and inventory[item]["stock"] >= qty:            subtotal += inventory[item]["price"] * qty            inventory[item]["stock"] -= qty    discount = subtotal * 0.10 if subtotal > 1000 else 0    tax = (subtotal - discount) * 0.08    return subtotal - discount + taxpayable = generate_bill({"Laptop": 1, "Mouse": 2})print(f"Grand Total Payable: ${payable:.2f}")print("Updated Stock:", inventory)



