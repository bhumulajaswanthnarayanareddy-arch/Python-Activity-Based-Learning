import relog_data = [    '192.168.1.10 - - [25/Oct/2026] "POST /login" 401',    '192.168.1.10 - - [25/Oct/2026] "POST /login" 401',    '192.168.1.10 - - [25/Oct/2026] "POST /login" 401',    '192.168.1.10 - - [25/Oct/2026] "POST /login" 401',    '10.0.0.5 - - [25/Oct/2026] "GET /index" 200']def detect_anomalies(logs):    failures = {}    for line in logs:        match = re.search(            r'(\d+\.\d+\.\d+\.\d+).*?"\s+(\d{3})',            line        )        if match:            ip, status = match.group(1), match.group(2)            if status == "401":                failures[ip] = failures.get(ip, 0) + 1    return [        ip for ip, count in failures.items()        if count >= 3    ]print("Suspicious IPs:", detect_anomalies(log_data))



